#!/bin/sh
# prok -- expose a local port at https://<name>.$PROK_RELAY (or at any
# hostname the relay serves, given in full) via the prok relay, spoken
# to with frpc over wss:443. The hostname lives exactly as long as the
# tunnel process does.
#
# Run bare for the docs. Wraps frpc because raw frpc has two traps this
# script closes: a taken name is only a log warning (frpc stays up,
# retrying, and silently seizes the name when its holder disconnects),
# and success is only visible in the log. Here: `up` polls frpc's admin
# API, prints the URL on success, and exits non-zero after killing frpc
# on any proxy error; `status` answers "what is my URL and is it up".
set -u

STATE="${TMPDIR:-/tmp}/prok.$(id -u)"

docs() {
  cat <<EOF
prok -- claim a hostname on the relay while a tunnel process lives

usage:
  prok up <name> <port> [user:pass]       expose localhost:<port> as https://<name>.\$PROK_RELAY
  prok up <hostname> <port> [user:pass]   ... as https://<hostname> (a full name the relay serves)
  prok status [<name|hostname>]           each tunnel: hostname, URL, state
  prok down [<name|hostname>]             kill tunnel(s), releasing the hostname(s)

up runs in the foreground: the name is claimed while the process lives
and released the moment it dies. It prints the public URL once the relay
confirms the proxy is running, and FAILS FAST (non-zero exit, frpc
killed) if the name is taken -- raw frpc would sit on a taken name
retrying and silently seize it later. The same watchdog keeps running
after startup, so a name lost across a reconnect also kills the tunnel
loudly instead of lurking.

rules:
  - <name>: one lowercase DNS label ([a-z0-9-], max 63 chars); it comes
    up at <name>.\$PROK_RELAY. A <hostname> (lowercase labels joined by
    dots) is claimed exactly as given; which domains the relay actually
    serves is the relay operator's business -- a hostname on a domain
    the relay does not route is accepted and shows "running", but
    nothing answers it. PROK_KNOWN_DOMAINS (optional, comma-separated)
    makes prok warn about such a domain. Hostnames are unique across
    ALL clients of the relay.
  - Who can reach a hostname depends on how the relay operator set up
    its domain. Unless your project guidance says otherwise, assume
    anyone can: scanners find new hostnames in minutes, so add a random
    suffix and gate anything sensitive with [user:pass] -- the relay
    then answers 401 without credentials (HTTP basic auth, enforced
    relay-side, no setup).
  - HTTP only (websockets fine); no raw TCP/UDP.

environment (required):
  PROK_AUTHTOKEN  shared secret (a credential: set via
                  \`byre credentials set\` or env_from_host, never a
                  baked [env] literal)
  PROK_RELAY      relay base hostname; bare names come up under it;
                  the control channel is <relay>:443

environment (optional):
  PROK_KNOWN_DOMAINS  comma-separated domains the relay serves besides
                  PROK_RELAY; a hostname outside them gets a warning

state lives under $STATE (config, pid, log per tunnel); configs hold no
secrets -- frpc resolves the token from the environment at connect time.
EOF
}

die() { printf 'prok: %s\n' "$*" >&2; exit 1; }

need_env() {
  [ -n "${PROK_RELAY:-}" ] || die "PROK_RELAY is not set -- the relay base hostname; set it in the project config (env_from_host or [env]; it is not a secret) and relaunch"
  [ -n "${PROK_AUTHTOKEN:-}" ] || die "PROK_AUTHTOKEN is not set -- a credential: set it via \`byre credentials set PROK_AUTHTOKEN\` or env_from_host (never a baked [env] literal) and relaunch"
}

need_bin() {
  for b in frpc curl jq flock; do
    command -v "$b" >/dev/null 2>&1 || die "$b not found on PATH"
  done
}

# "$1"'s "status<TAB>err" from an admin API answer on stdin. Selecting by
# name matters: while probing for a free admin port we can curl an admin
# API belonging to ANOTHER of our tunnels, whose different proxy must
# read as "not ours yet", never as our success.
proxy_state() {
  jq -r --arg n "$1" \
    '[.[][]? | select(.name == $n)] | if length == 0 then "" else .[0] | "\(.status)\t\(.err)" end' \
    2>/dev/null
}

alive() { kill -0 "$1" 2>/dev/null; }

# Every path that creates, reclaims, or removes a tunnel's state files
# runs under a kernel lock on $STATE/<name>.lockf (fd 9), so a stale
# takeover and a delayed cleanup can never interleave into two owners or
# a deleted replacement. flock is released automatically when the
# process dies -- die mid-section included -- so there is no stale-lock
# state to steal or repair. The lockfile itself is NEVER deleted: a new
# open would mint a fresh inode and locks on different inodes don't
# exclude each other.
# Usage: grab <name> [wait-secs] ... drop  (in-process paths), or a
# subshell with `9>"$STATE/$name.lockf"` on its closing paren.
grab() {
  exec 9>>"$STATE/$1.lockf" || return 1
  flock -w "${2:-5}" 9
}
drop() { flock -u 9 2>/dev/null; }

# Remove a tunnel's state, pidfile last -- while the pidfile exists the
# name reads as owned, so nothing else starts rebuilding the state
# mid-removal. Caller holds the lock.
clear_state() {
  rm -f "$STATE/$1.admin" "$STATE/$1.toml" "$STATE/$1.log" "$STATE/$1.pid.new"
  rm -f "$STATE/$1.pid"
}

up() {
  name="${1:-}"; port="${2:-}"; auth="${3:-}"
  [ -n "$name" ] && [ -n "$port" ] || die "usage: prok up <name|hostname> <port> [user:pass]"
  # grep matches per line, so an embedded newline would smuggle a bad
  # line past the pattern (and into filenames and the TOML) -- reject
  # newlines in every argument first.
  nl='
'
  case "$name$port$auth" in *"$nl"*) die "arguments must not contain newlines" ;; esac
  # printf, not echo: dash's echo expands backslash escapes, so a name
  # holding a literal \n would reach grep as two lines.
  printf '%s\n' "$name" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$' \
    && [ "${#name}" -le 253 ] \
    || die "bad name '$name': lowercase DNS labels ([a-z0-9-], max 63 chars each), joined by dots"
  need_env
  # A bare label lives under the relay host; a dotted name is a full
  # hostname, claimed as given. The hostname is the proxy NAME too (the
  # relay keys every proxy by name, whatever domain it is on, so the
  # label alone would collide across domains) and the key of all state
  # below. frp has two proxy forms: a `subdomain` under the relay's own
  # domain, or `customDomains` for anything else.
  case "$name" in
    *.*) host="$name" ;;
    *)   host="$name.$PROK_RELAY" ;;
  esac
  case "$host" in
    *".$PROK_RELAY")
      label="${host%".$PROK_RELAY"}"
      case "$label" in
        *.*) proxyline="customDomains = ['$host']" ;;   # a.b.<relay>: frp refuses it, and says so
        *)   proxyline="subdomain = '$label'" ;;
      esac ;;
    *) proxyline="customDomains = ['$host']" ;;
  esac
  if [ -n "${PROK_KNOWN_DOMAINS:-}" ]; then
    domain="${host#*.}"
    case ",$PROK_RELAY,$(printf '%s' "$PROK_KNOWN_DOMAINS" | tr -d ' ')," in
      *",$domain,"*) ;;
      *) printf 'prok: warning: %s is not a known relay domain (PROK_RELAY=%s, PROK_KNOWN_DOMAINS=%s); the relay will accept %s but nothing may answer it\n' \
           "$domain" "$PROK_RELAY" "$PROK_KNOWN_DOMAINS" "$host" >&2 ;;
    esac
  fi
  name="$host"
  printf '%s\n' "$port" | grep -Eq '^[0-9]+$' && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] \
    || die "bad port '$port'"
  authlines=""
  if [ -n "$auth" ]; then
    case "$auth" in
      *"'"*) die "user:pass must not contain single quotes" ;;
      *:*)
        u="${auth%%:*}"; p="${auth#*:}"
        # frp skips the auth check entirely when either field is empty,
        # so ':' from two unset shell variables must not pass silently.
        [ -n "$u" ] && [ -n "$p" ] || die "auth must be user:pass with both parts non-empty"
        authlines="httpUser = '$u'
httpPassword = '$p'" ;;
      *) die "auth must be user:pass" ;;
    esac
  fi
  need_bin
  mkdir -p "$STATE" && chmod 700 "$STATE"

  # $name.pid marks ownership from BEFORE frpc starts: the wrapper's pid
  # during startup, frpc's once running -- so a concurrent `up` refuses,
  # and `down` can kill this tunnel from the moment anything exists to
  # manage. A dead pid in the file is stale state from a hard-killed
  # wrapper: overwrite it, under the lock.
  pidfile="$STATE/$name.pid"
  grab "$name" || die "another prok operation on '$name' is stuck holding $STATE/$name.lockf"
  oldpid="$(cat "$pidfile" 2>/dev/null)"
  if [ -n "$oldpid" ] && alive "$oldpid"; then
    die "'$name' is already up or starting from this box (prok down $name first)"
  fi
  printf '%s\n' "$$" > "$pidfile"
  drop

  # Kill frpc and remove the state -- but only state that is still ours:
  # a replacement `up` may own the name if our frpc already died. The
  # re-grab is safe from any point: flock on the fd we already hold
  # succeeds immediately, and on exit the kernel releases whatever we
  # held.
  pid=""
  release() {
    kill "$pid" 2>/dev/null
    if grab "$name"; then
      owner="$(cat "$pidfile" 2>/dev/null)"
      if [ "$owner" = "$$" ] || { [ -n "$pid" ] && [ "$owner" = "$pid" ]; }; then
        clear_state "$name"
      fi
      drop
    fi
  }
  trap 'release; exit 130' INT TERM HUP
  fail() { release; die "$@"; }

  # The admin API is how we distinguish "running" from frpc's quiet
  # retry-forever on a taken name. Ports may be held by our other
  # tunnels; frpc exits at once on a taken bind, so just try the next.
  admin=7400
  while [ "$admin" -le 7449 ]; do
    cat > "$STATE/$name.toml" <<EOF
serverAddr = '{{ .Envs.PROK_RELAY }}'
serverPort = 443
transport.protocol = "wss"
transport.tls.trustedCaFile = "/etc/ssl/certs/ca-certificates.crt"
auth.token = '{{ .Envs.PROK_AUTHTOKEN }}'
log.disablePrintColor = true
webServer.addr = "127.0.0.1"
webServer.port = $admin

[[proxies]]
name = '$name'
type = "http"
$proxyline
localPort = $port
$authlines
EOF
    # Signals are ignored (dropped, not deferred) across the spawn and
    # the pid capture: a signal landing exactly between the two would
    # otherwise run release() before it knows this frpc's pid, leaving
    # an unmanaged client holding -- or later seizing -- the name. The
    # window is microseconds; a perfectly timed Ctrl-C is swallowed and
    # the next one works.
    trap '' INT TERM HUP
    frpc -c "$STATE/$name.toml" > "$STATE/$name.log" 2>&1 &
    pid=$!
    trap 'release; exit 130' INT TERM HUP

    tries=0
    while [ "$tries" -lt 40 ]; do
      if ! alive "$pid"; then
        if grep -q "bind: address already in use" "$STATE/$name.log"; then
          admin=$((admin + 1)); continue 2
        fi
        echo "prok: frpc exited during startup:" >&2
        tail -3 "$STATE/$name.log" >&2
        fail "could not start '$name'"
      fi
      state="$(curl -s --max-time 2 "http://127.0.0.1:$admin/api/status" | proxy_state "$name")"
      case "$state" in
        running*)
          # Handover from wrapper pid to frpc pid, under the lock and
          # ownership-checked: if frpc died this instant, a concurrent
          # `up` may have reclaimed the name already, and its fresh
          # state must not be overwritten. The rename keeps the file
          # non-empty at every instant (a plain > truncates first, and
          # an empty pidfile reads as "no owner").
          grab "$name" || fail "another prok operation on '$name' is stuck holding $STATE/$name.lockf"
          if [ "$(cat "$pidfile" 2>/dev/null)" != "$$" ]; then
            fail "lost ownership of '$name' during startup"
          fi
          printf '%s\n' "$pid" > "$pidfile.new" && mv "$pidfile.new" "$pidfile"
          echo "$admin" > "$STATE/$name.admin"
          drop
          printf 'https://%s\n' "$name"
          [ -n "$auth" ] && printf '(basic auth: %s:...)\n' "${auth%%:*}"
          trap 'kill "$pid" 2>/dev/null' INT TERM HUP
          # Keep watching: after a reconnect (relay restart, network
          # blip) frps re-evaluates the name, and one taken meanwhile
          # puts frpc back into its silent retry-forever -- the same
          # footgun as at startup, so the same response: kill and fail.
          err=""
          while alive "$pid"; do
            sleep 2
            state="$(curl -s --max-time 2 "http://127.0.0.1:$admin/api/status" | proxy_state "$name")"
            case "$state" in
              *error*)
                err="${state#*	}"
                kill "$pid" 2>/dev/null
                ;;
            esac
          done
          wait "$pid"
          rc=$?
          # Clean up only what is still ours: after a hard kill and a
          # replacement `up`, the state belongs to the new tunnel. The
          # ownership check and the removal sit under the same lock.
          if grab "$name"; then
            [ "$(cat "$pidfile" 2>/dev/null)" = "$pid" ] && clear_state "$name"
            drop
          fi
          [ -n "$err" ] && die "'$name': \"$err\" after a reconnect -- frpc was killed so it cannot seize the name later"
          exit "$rc"
          ;;
        *error*)
          err="${state#*	}"
          case "$err" in
            *"router config conflict"*|*"already exists"*)
              fail "name '$name' is taken on the relay ($err) -- pick another; frpc was killed so it cannot seize the name later" ;;
            *)
              fail "proxy failed: $err" ;;
          esac
          ;;
      esac
      tries=$((tries + 1)); sleep 0.5
    done
    echo "prok: no answer from the relay after 20s; last log lines:" >&2
    tail -3 "$STATE/$name.log" >&2
    fail "gave up waiting for '$name'"
  done
  fail "no free admin port in 7400-7449"
}

# A bare label given to status/down means <label>.$PROK_RELAY, as in up;
# only that case needs PROK_RELAY, so `prok down` works with no env at all.
resolve() {
  case "$1" in
    ""|*.*) printf '%s' "$1" ;;
    *) [ -n "${PROK_RELAY:-}" ] || return 1
       printf '%s.%s' "$1" "$PROK_RELAY" ;;
  esac
}
no_relay() { die "PROK_RELAY is not set -- needed to resolve the bare name '$1' (or give the full hostname)"; }

status() {
  need_env; only="$(resolve "${1:-}")" || no_relay "$1"; found=1; rc=0
  for pidf in "$STATE"/*.pid; do
    [ -f "$pidf" ] || continue
    name="$(basename "$pidf" .pid)"
    [ -n "$only" ] && [ "$name" != "$only" ] && continue
    found=0
    pid="$(cat "$pidf")"
    if ! alive "$pid"; then
      printf '%s\thttps://%s\tdead (stale state removed)\n' "$name" "$name"
      # Re-check under the lock: a replacement `up` may own it by now.
      ( flock -w 2 9 || exit
        p="$(cat "$pidf" 2>/dev/null)"
        [ -n "$p" ] && ! alive "$p" && clear_state "$name"
      ) 9>>"$STATE/$name.lockf"
      rc=1; continue
    fi
    admin="$(cat "$STATE/$name.admin" 2>/dev/null)"
    state="$(curl -s --max-time 2 "http://127.0.0.1:${admin:-0}/api/status" | proxy_state "$name")"
    st="${state%%	*}"; err="${state#*	}"
    case "$st" in
      running) printf '%s\thttps://%s\trunning\n' "$name" "$name" ;;
      "") printf '%s\thttps://%s\tstarting (admin API not answering yet)\n' "$name" "$name"; rc=1 ;;
      *) printf '%s\thttps://%s\t%s\n' "$name" "$name" "$st${err:+ ($err)}"; rc=1 ;;
    esac
  done
  if [ "$found" -ne 0 ]; then
    [ -n "$only" ] && die "no tunnel named '$only' from this box"
    echo "no tunnels up from this box"
  fi
  exit "$rc"
}

down() {
  only="$(resolve "${1:-}")" || no_relay "$1"; hit=1
  for pidf in "$STATE"/*.pid; do
    [ -f "$pidf" ] || continue
    name="$(basename "$pidf" .pid)"
    [ -n "$only" ] && [ "$name" != "$only" ] && continue
    hit=0
    pid="$(cat "$pidf")"
    if alive "$pid"; then
      kill "$pid" 2>/dev/null
      printf '%s: killed (name released)\n' "$name"
    else
      printf '%s: was already dead\n' "$name"
    fi
    # A live `up` wrapper cleans its own state when its wait returns;
    # this covers orphans whose wrapper is gone. The pidfile-content
    # check keeps hands off a replacement tunnel that reclaimed the
    # name in the meantime; check and removal sit under the same lock.
    ( sleep 1
      flock -w 2 9 || exit
      [ "$(cat "$pidf" 2>/dev/null)" = "$pid" ] && ! alive "$pid" && clear_state "$name"
    ) 9>>"$STATE/$name.lockf" &
  done
  if [ "$hit" -ne 0 ]; then
    [ -n "$only" ] && die "no tunnel named '$only' from this box"
    echo "no tunnels up from this box"
  fi
}

case "${1:-}" in
  up)     shift; up "$@" ;;
  status) shift; status "${1:-}" ;;
  down)   shift; down "${1:-}" ;;
  ""|-h|--help|help) docs ;;
  *) die "unknown command '${1}' (run \`prok\` for the docs)" ;;
esac
