#!/bin/sh
set -eu

# Keep Z.AI's Codex state completely separate from the ordinary Codex agent.
# The directory is a byre state-volume mount in a built box; mkdir also makes
# this launcher usable when invoked while assembling or testing an image.
zai_home=${ZAI_CODEX_HOME:-/home/dev/.zai-codex-home}
zai_config_template=${ZAI_CONFIG_TEMPLATE:-/usr/local/share/byre-zai/config.toml}
zai_models_template=${ZAI_MODELS_TEMPLATE:-/usr/local/share/byre-zai/models.json}

zai_codex=${ZAI_CODEX_BIN:-codex}
case $zai_codex in
    */*) ;;
    *) zai_codex=$(command -v "$zai_codex" 2>/dev/null || true) ;;
esac
if [ -z "$zai_codex" ] || [ ! -x "$zai_codex" ]; then
    echo "zai: Codex or its byre launch adapter is required but was not found" >&2
    echo "     enable byre's Codex skill in this box, then rebuild it" >&2
    exit 127
fi

umask 077
mkdir -p "$zai_home"
if [ ! -e "$zai_home/config.toml" ]; then
    cp "$zai_config_template" "$zai_home/config.toml"
fi
if [ ! -e "$zai_home/models.json" ]; then
    cp "$zai_models_template" "$zai_home/models.json"
fi

exec env CODEX_HOME="$zai_home" "$zai_codex" "$@"
